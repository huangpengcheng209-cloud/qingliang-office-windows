+	// A ZIP container that could not be opened/classified must not fall through
+	// to the extension-based TXT/CSV defaults. On Windows an editor can hold a
+	// write-capable handle: the byte probe still succeeds, while minizip's
+	// stricter sharing mode rejects the archive. Treating its compressed bytes
+	// as text otherwise produces a successful but empty PDF.
+	const bool hasZipSignature = dwDetectdBytes >= 4 &&
+		bufferDetect[0] == 'P' && bufferDetect[1] == 'K' &&
+		((bufferDetect[2] == 3 && bufferDetect[3] == 4) ||
+		 (bufferDetect[2] == 5 && bufferDetect[3] == 6) ||
+		 (bufferDetect[2] == 7 && bufferDetect[3] == 8));
+	if (hasZipSignature)
+	{
+		delete[] bufferDetect;
+		file.CloseFile();
+		nFileType = AVS_OFFICESTUDIO_FILE_OTHER_ZIP;
+		return true;
+	}
+
