--- /dev/null
+++ b/common/loginpage/src/css/workbench-quality.less
@@ -0,0 +1,178 @@
+// Qingliang community, 2026-10-23. Native workbench finish; no external fonts or imagery.
+#placeholder {
+  --ql-canvas: #f7f9fc;
+  --ql-surface: #fff;
+  --ql-ink: #18243a;
+  --ql-muted: #63738a;
+  --ql-line: #e4e9f1;
+  --ql-soft: #eef3fa;
+  --ql-accent: #2563df;
+  --ql-selected: #e9f0ff;
+  --ql-shadow: 0 8px 24px rgba(24, 39, 68, .045);
+  font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
+}
+.theme-type-dark #placeholder {
+  --ql-canvas: #191d25;
+  --ql-surface: #232934;
+  --ql-ink: #edf1f7;
+  --ql-muted: #a9b5c8;
+  --ql-line: #394253;
+  --ql-soft: #2c3543;
+  --ql-accent: #91b5ff;
+  --ql-selected: #2e4164;
+  --ql-shadow: none;
+}
+#placeholder > .tool-menu {
+  background: var(--ql-surface); border-inline-end: 1px solid var(--ql-line);
+  > li.menu-item:not(.separator):not(.devider) {
+    border-radius: 10px;
+    a { height: 46px; font-size: 14px; padding: 8px 16px; gap: 13px; }
+    &.selected { background: var(--ql-selected); }
+    &.selected a { color: var(--ql-accent); }
+    &.selected svg.icon:not(.icon-colored) { stroke: var(--ql-accent); }
+  }
+}
+.recents { background: var(--ql-canvas); }
+.recents .recent-panel-container {
+  width: 100%; max-width: 1320px; margin: 0 auto;
+  padding: 38px 40px 40px; background: transparent !important;
+  color: var(--ql-ink); overflow-y: auto;
+}
+.ql-workbench-header {
+  display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 28px;
+  text-align: start;
+  h1 { margin: 8px 0 10px; text-align: start; font-size: 30px; font-weight: 650; line-height: 1.3; letter-spacing: -.6px; }
+  p { margin: 0; }
+  .ql-eyebrow { color: var(--ql-muted); font-size: 12px; letter-spacing: .5px; }
+  .ql-workbench-description { color: var(--ql-muted); font-size: 14px; line-height: 1.6; }
+}
+.recents button, .recents input { font-family: inherit; }
+.ql-open-existing {
+  display: inline-flex; flex-shrink: 0; align-items: center; gap: 9px;
+  min-height: 42px; height: auto; padding: 0 17px; border: 1px solid var(--ql-line);
+  border-radius: 10px; background: var(--ql-surface); color: var(--ql-ink);
+  font-size: 13px; font-weight: 600; box-shadow: var(--ql-shadow);
+  svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.6; }
+  &:hover { background: var(--ql-selected); border-color: var(--ql-accent); }
+}
+.document-creation-grid { gap: 16px; }
+.recents .document-creation-item {
+  min-height: 154px; padding: 20px; border: 1px solid var(--ql-line); border-radius: 14px;
+  background: var(--ql-surface); color: var(--ql-ink); box-shadow: var(--ql-shadow);
+  transition: transform 160ms cubic-bezier(.2,.8,.2,1), box-shadow 160ms ease, border-color 160ms ease;
+  .ql-card-icon { top: 18px; left: 20px; width: 39px; height: 39px; border-radius: 10px; box-shadow: none; }
+  .ql-card-icon svg { width: 26px; height: 26px; stroke-width: 2; }
+  .ql-card-arrow { top: 27px; right: 20px; font-size: 22px; color: var(--ql-muted); transition: transform 160ms ease; }
+  .title { font-size: 17px; line-height: 1.4; font-weight: 600; }
+  .description { position: absolute; top: 30px; left: 69px; font-size: 10px; letter-spacing: .7px; color: var(--ql-muted); margin: 0; }
+  .ql-card-hint { color: var(--ql-muted); font-size: 12px; margin-top: 5px; line-height: 1.5; }
+  &:hover { border-color: var(--ql-accent); box-shadow: 0 12px 28px rgba(24,39,68,.09); transform: translateY(-3px); }
+  &:hover .ql-card-arrow { transform: translateX(3px); }
+  &:active { transform: translateY(-1px); }
+}
+.recents #box-container { margin-top: 34px; }
+.recents #box-recent {
+  .file-list-title h2 { color: var(--ql-ink); font-size: 18px; font-weight: 600; }
+  .ql-recent-heading { display: flex; align-items: baseline; gap: 12px; }
+  .ql-recent-count { font-size: 12px; color: var(--ql-muted); }
+  .ql-more-recent { height: 30px; font-size: 12px; color: var(--ql-muted); padding: 2px 5px; border-radius: 5px; }
+  .ql-more-recent:hover { color: var(--ql-accent); }
+  .file-list-body { display: block; background: var(--ql-surface); border-color: var(--ql-line); border-radius: 12px; box-shadow: var(--ql-shadow); }
+  .file-list-body.ql-zero-matches { display: none; }
+  .file-list-body .row:nth-child(n) { display: grid; }
+  .file-list-body .row {
+    grid-template-columns: minmax(0,1fr) 135px 30px 30px;
+    min-height: 73px; padding: 10px 18px; gap: 0 9px;
+    background: var(--ql-surface); border-color: var(--ql-line);
+    transition: background-color 120ms ease;
+    &:hover, &:focus-within { background: var(--ql-soft); }
+    &.pinned { box-shadow: inset 2px 0 0 var(--ql-accent); }
+    .col-name { color: var(--ql-ink); cursor: pointer; border-radius: 4px; }
+    .col-name p { margin-left: 48px; font-size: 14px; font-weight: 500; }
+    .col-name > .icon { left: 17px; top: 17px; width: 30px; height: 37px; }
+    .col-location { margin-left: 48px; font-size: 12px; color: var(--ql-muted); }
+    .col-date { grid-column: 2; display: block; color: var(--ql-muted); font-size: 12px; }
+    .col-pin { display: flex; grid-column: 3; grid-row: 1 / 3; position: static; opacity: 1; }
+    .col-more { grid-column: 4; }
+    .col-pin, .col-more { width: 30px; min-width: 30px; }
+    .btn-quick { width: 30px; height: 30px; flex: 0 0 30px; padding: 6px; color: var(--ql-muted); border-radius: 6px; background: transparent; }
+    .btn-quick svg.icon { width: 18px; height: 18px; display: block; }
+    .btn-quick:hover { background: var(--ql-selected); }
+    .col-pin button[aria-pressed="true"] { color: var(--ql-accent); background: var(--ql-selected); }
+  }
+  .ql-recent-empty, .ql-no-results {
+    padding: 36px 20px; border: 1px dashed var(--ql-line); border-radius: 12px;
+    color: var(--ql-muted); text-align: center; background: var(--ql-surface); font-size: 13px;
+    strong { display: block; color: var(--ql-ink); font-size: 15px; font-weight: 600; margin-bottom: 8px; }
+    p { margin: 0; line-height: 1.6; }
+  }
+  .ql-no-results svg { width: 28px; height: 28px; fill: none; stroke: var(--ql-muted); stroke-width: 1.5; margin-bottom: 12px; }
+  .ql-reset-filter { margin-top: 16px; height: 32px; padding: 0 14px; border-radius: 7px; background: var(--ql-selected); color: var(--ql-accent); }
+  [hidden] { display: none !important; }
+}
+.ql-recent-controls { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 2px 0 16px; flex-wrap: wrap; }
+.theme-type-dark .recents #box-recent .file-list-body,
+.theme-type-dark .recents #box-recent .file-list-body .row { background: var(--ql-surface); border-color: var(--ql-line); }
+.theme-type-dark .recents #box-recent .file-list-body .row:hover,
+.theme-type-dark .recents #box-recent .file-list-body .row:focus-within { background: var(--ql-soft); }
+.ql-filter-types {
+  display: flex; align-items: center; gap: 4px; flex-wrap: wrap;
+  button { height: 32px; padding: 0 12px; border-radius: 7px; background: transparent; color: var(--ql-muted); font-size: 12px; white-space: nowrap;
+    &:hover { background: var(--ql-soft); color: var(--ql-ink); }
+    &[aria-pressed="true"] { background: var(--ql-selected); color: var(--ql-accent); font-weight: 600; }
+  }
+}
+.ql-recent-search {
+  display: flex; align-items: center; position: relative; flex: 0 1 270px; min-width: 200px;
+  height: 36px; background: var(--ql-surface); border: 1px solid var(--ql-line); border-radius: 8px;
+  svg { width: 16px; height: 16px; margin-left: 11px; flex-shrink: 0; fill: none; stroke: var(--ql-muted); stroke-width: 1.6; }
+  input { width: 100%; min-width: 0; height: 100%; padding: 0 30px 0 9px; border: 0; outline: 0; background: transparent; color: var(--ql-ink); font-size: 12px; border-radius: 8px; }
+  input::placeholder { color: var(--ql-muted); }
+  input::-webkit-search-cancel-button { -webkit-appearance: none; }
+  &:focus-within { border-color: var(--ql-accent); box-shadow: 0 0 0 3px var(--ql-selected); }
+  .ql-clear-search { position: absolute; right: 4px; top: 4px; width: 26px; height: 26px; padding: 0; border-radius: 5px; background: transparent; color: var(--ql-muted); font-size: 20px; }
+}
+#placeholder .recents :focus-visible { outline: 2px solid var(--ql-accent); outline-offset: 3px; }
+#placeholder .recents input:focus-visible { outline: 0; }
+.recents .document-creation-grid { animation: ql-workbench-arrive 220ms ease-out both; }
+@keyframes ql-workbench-arrive { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
+@media (max-width: 1120px) {
+  .recents .recent-panel-container { padding: 28px; }
+  .recents #box-recent .file-list-body .row { grid-template-columns: minmax(0,1fr) 30px 30px; }
+  .recents #box-recent .file-list-body .row .col-date { display: none; }
+  .recents #box-recent .file-list-body .row .col-pin { grid-column: 2; }
+  .recents #box-recent .file-list-body .row .col-more { grid-column: 3; }
+}
+@media (max-width: 780px) {
+  .ql-workbench-header { align-items: flex-start; flex-direction: column; gap: 18px; }
+  .ql-recent-search { flex-basis: 100%; }
+  .ql-workbench-header h1 { font-size: 26px; }
+  .recents .recent-panel-container { padding: 24px 20px; }
+}
+@media (max-width: 1050px) {
+  .recents .document-creation-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
+  .recents .document-creation-item { min-height: 132px; }
+}
+@media (max-width: 650px) {
+  .recents .document-creation-grid { grid-template-columns: 1fr; }
+}
+.rtl .recents {
+  .ql-card-arrow { right: auto; left: 20px; transform: scaleX(-1); }
+  .ql-card-icon { left: auto; right: 20px; }
+  .document-creation-item .description { left: auto; right: 69px; }
+  .ql-recent-search svg { margin-left: 0; margin-right: 11px; }
+  .ql-clear-search { right: auto; left: 4px; }
+  .ql-recent-search input { padding: 0 9px 0 30px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  #placeholder .recents *, #placeholder .recents *::before, #placeholder .recents *::after {
+    animation: none !important; transition: none !important; scroll-behavior: auto !important;
+  }
+  #placeholder .recents .document-creation-item:hover,
+  #placeholder .recents .document-creation-item:active { transform: none; }
+}
+@media (forced-colors: active) {
+  .ql-filter-types button[aria-pressed="true"], .recents .document-creation-item, .ql-recent-search {
+    border: 1px solid ButtonText;
+  }
+}
