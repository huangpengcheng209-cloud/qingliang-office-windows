+// Qingliang community, 2026-10-23: allow an explicit isolated settings file for acceptance profiles.
+namespace QingliangDesktop {
+inline std::unique_ptr<QSettings> createUserSettings()
+{
+    const QString file = qEnvironmentVariable("QINGLIANG_SETTINGS_FILE");
+    if (!file.isEmpty() && QDir::isAbsolutePath(file))
+        return std::unique_ptr<QSettings>(new QSettings(file, QSettings::IniFormat));
+    return std::unique_ptr<QSettings>(new QSettings(QSettings::NativeFormat, QSettings::UserScope, REG_GROUP_KEY, REG_APP_NAME));
+}
