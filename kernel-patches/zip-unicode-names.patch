+	static std::wstring archive_entry_name(unzFile file)
+	{
+		unz_file_info info = {};
+		if (UNZ_OK != unzGetCurrentFileInfo(file, &info, NULL, 0, NULL, 0, NULL, 0))
+			return std::wstring();
+		std::vector<char> name(info.size_filename + 1, 0);
+		if (UNZ_OK != unzGetCurrentFileInfo(file, &info, name.data(), (uLong)name.size(), NULL, 0, NULL, 0))
+			return std::wstring();
+		return (info.flag & 2048)
+			? NSFile::CUtf8Converter::GetUnicodeStringFromUTF8((BYTE*)name.data(), info.size_filename)
+			: codepage_issue_fixFromOEM(name.data());
+	}
+	static int open_utf8_zip_entry(zipFile file, const std::wstring& name, const zip_fileinfo* info, int method, int level)
+	{
+		const std::string utf8 = NSFile::CUtf8Converter::GetUtf8StringFromUnicode2(name.c_str(), (LONG)name.size());
+		return zipOpenNewFileInZip4(file, utf8.c_str(), info, NULL, 0, NULL, 0, NULL,
+			method, level, 0, -MAX_WBITS, DEF_MEM_LEVEL, Z_DEFAULT_STRATEGY, NULL, 0, 0, 2048);
+	}
